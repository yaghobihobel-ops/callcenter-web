# Copy to .env, or let docker/init.sh create it with random secrets.
# Never commit the resulting .env or certificate private keys.
COMPOSE_PROJECT_NAME=callcenter-web

# Public HTTPS hostname (DNS-only when using Cloudflare).
CC_DOMAIN=call.example.com
# Public address reached by visitors, NOT a Cloudflare proxy address.
PUBLIC_IP=192.0.2.10
# Address assigned to the VM's network interface; see: ip -4 route get 1.1.1.1
# For a directly public VM this is normally the same as PUBLIC_IP.
CC_HOST_IP=192.0.2.10

APP_PORT=3006
# Published ONLY on host loopback for the host-networked backend.
DB_PORT=3306
DB_NAME=callcenter
DB_USER=callcenter
AMI_USER=callcenter
TURN_USER=callcenter

# init.sh replaces these markers. Use long, random values.
# Secrets may contain letters, digits, hyphen and underscore only.
DB_ROOT_PASS=__GENERATE_DB_ROOT__
DB_PASS=__GENERATE_DB__
JWT_SECRET=__GENERATE_JWT__
VISITOR_SIP_PASS=__GENERATE_VISITOR__
AMI_PASS=__GENERATE_AMI__
TURN_PASS=__GENERATE_TURN__
# Must contain {ext}; each operator gets a different password.
OP_SIP_PASS_PATTERN=Op{ext}-__GENERATE_OPERATORS__

# Existing certificate paths, relative to this compose file or absolute.
TLS_CERT_FILE=./docker/certs/fullchain.pem
TLS_KEY_FILE=./docker/certs/privkey.pem

TZ=Asia/Tehran
DB_TIME_ZONE=+03:30
SUPPORT_PHONE=+982191000000
SUPPORT_PHONE_DISPLAY=۰۲۱-۹۱۰۰۰۰۰۰
BRAND_NAME=فیرزو
BRAND_COLOR=#0ea5e9
