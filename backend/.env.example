# ==== Call Center backend — environment overrides ====
# Copy to .env next to server.js (or set in the systemd unit).
# Every value has a sane default (the original firuzo.online deployment),
# so an empty .env works for the reference deployment too.

# --- backend ---
CC_PORT=3006
CC_PUBLIC_ORIGIN=https://call.example.com      # the panel/widget origin (no trailing slash)
CC_JWT=change-me-to-a-long-random-string       # JWT signing secret

# --- database (MySQL/MariaDB) ---
CC_DB_HOST=127.0.0.1
CC_DB_PORT=3306
CC_DB_USER=callcenter
CC_DB_PASS=change-me
CC_DB_NAME=callcenter

# --- Asterisk PBX host (LAN) ---
CC_PBX_HOST=192.168.100.85                     # used for SFTP recording pull
CC_AMI_HOST=192.168.100.85
CC_AMI_PORT=5038
CC_AMI_USER=callcenter
CC_AMI_PASS=change-me
CC_APP_LAN_IP=192.168.100.65                   # LAN IP of THIS backend host (dialplan callback guard)

# --- SIP accounts (must match pjsip.conf on the PBX host) ---
CC_DIAL_EXT=200                                # extension the widget dials
CC_VISITOR_SIP_PASS=change-me                  # [visitor] password in pjsip.conf
CC_OP_SIP_PASS=FzOp{ext}!x                     # operator ext pattern, {ext} replaced by 1000..1005

# --- TURN/STUN relay (coturn on the app host) ---
CC_TURN_PUBLIC_IP=203.0.113.10                 # public IP reachable by visitors
CC_TURN_LAN_IP=192.168.100.65
CC_TURN_USER=callcenter
CC_TURN_PASS=change-me

# --- recordings ---
CC_REC_SPOOL=/var/spool/asterisk/monitor       # on PBX host (via SFTP)
CC_REC_LOCAL=/opt/callcenter/recordings        # local cache dir
CC_SFTP_KEY=/opt/callcenter/secrets/cc_rsa     # private key accepted by the PBX host

# --- branding / widget defaults ---
CC_SUPPORT_PHONE=+982191000000
CC_SUPPORT_PHONE_DISPLAY=۰۲۱-۹۱۰۰۰۰۰۰
CC_BRAND_NAME=فیرزو
CC_BRAND_COLOR=#0ea5e9
