; ==== Call Center - PJSIP (WebRTC over WSS/WS) ====
; Rendered by installer/install.sh from this template.
; Placeholders: __VISITOR_PASS__ __OP_PASS_1000__ .. __OP_PASS_1005__
;               __PBX_BIND_IP__ (optional, default 0.0.0.0)
;
[global]
default_outbound_endpoint=visitor

[system]
type=system
timers=t1min

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0

[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0

; ---- WebRTC template ----
[webrtc-tpl]!
type=endpoint
transport=transport-ws
webrtc=yes
dtls_auto_generate_cert=yes
media_encryption=dtls
disallow=all
; NOTE: ulaw only. Do NOT add opus unless the codec module is installed,
; otherwise IVR audio is silent and recordings come out empty (44 bytes).
allow=ulaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
ice_support=yes
use_avpf=yes
rtcp_mux=yes
bundle=yes
max_audio_streams=1
context=from-widget
device_state_busy_at=3

; ---- Visitor (shared account for website widget) ----
[visitor](webrtc-tpl)
auth=visitor
aors=visitor

[visitor]
type=auth
auth_type=userpass
username=visitor
password=__VISITOR_PASS__

[visitor]
type=aor
max_contacts=30
remove_existing=no
qualify_frequency=0

; ---- Operator extensions (web phones) ----
; Each operator panel user is mapped to one of these extensions.
; Passwords must match backend env CC_OP_SIP_PASS (pattern FzOp<ext>!x).
[1000](webrtc-tpl)
context=from-internal
auth=auth1000
aors=1000

[auth1000]
type=auth
auth_type=userpass
username=1000
password=__OP_PASS_1000__

[1000]
type=aor
max_contacts=2
remove_existing=yes
qualify_frequency=60

