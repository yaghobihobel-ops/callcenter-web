; ==== Call Center - AMI (LAN only) ====
; Rendered by installer/install.sh from this template.
; Placeholders: __AMI_USER__ __AMI_PASS__ __APP_HOST__ (LAN IP of backend host)
;
[general]
enabled=yes
webenabled=no
port=5038
bindaddr=0.0.0.0
displayconnects=no

[__AMI_USER__]
secret = __AMI_PASS__
deny=0.0.0.0/0.0.0.0
permit=__APP_HOST__/255.255.255.255
read = all
write = all
writetimeout = 100
